<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: wie backup_rules – Token weder in die Cloud-Sicherung noch beim Gerätewechsel übertragen. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="worker.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="worker.xml" />
    </device-transfer>
</data-extraction-rules>
