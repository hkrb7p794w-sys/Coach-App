// Cloudflare Worker „coach-ai“: KI-Weiterleitung für die Coach-App.
// Secrets (GEMINI_API_KEY, GROQ_API_KEY, COACH_APP_TOKEN) setzt der Deploy-Workflow aus GitHub-Secrets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coach-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // IPA und Versionsangaben für die private SideStore-Quelle (Upload durch ios-build.yml).
  // Ranglisten zwischen Nutzer:innen (nur Namen und Punkte, siehe src/league.ts).
  "kv_namespaces": [
    { "binding": "RELEASES", "id": "103715a4f0004a398c9e75637a2edf36" },
    { "binding": "LEAGUE", "id": "41093b08a16e441ba7ca34b5d423364b" }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "GEMINI_MODEL": "gemini-3.6-flash",
    "GROQ_MODEL": "llama-3.3-70b-versatile",
    "GROQ_VISION_MODEL": "meta-llama/llama-4-scout-17b-16e-instruct"
  }
}
