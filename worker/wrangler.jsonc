// Cloudflare Worker „coach-ai“: KI-Weiterleitung für die Coach-App.
// Secrets (GEMINI_API_KEY, CEREBRAS_API_KEY, GROQ_API_KEY, MISTRAL_API_KEY, COACH_APP_TOKEN) setzt der Deploy-Workflow aus GitHub-Secrets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coach-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Im Dashboard gesetzte Variablen (z. B. REVOKED_GUESTS) bleiben beim Deploy erhalten.
  "keep_vars": true,
  // Anfragen je Zugang und Minute.
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  // IPA und Versionsangaben für die private SideStore-Quelle (Upload durch ios-build.yml).
  // Ranglisten zwischen Nutzer:innen (nur Namen und Punkte, siehe src/league.ts).
  "kv_namespaces": [
    { "binding": "RELEASES", "id": "103715a4f0004a398c9e75637a2edf36" },
    { "binding": "LEAGUE", "id": "41093b08a16e441ba7ca34b5d423364b" }
  ],
  // Workers AI: offene Modelle bei Cloudflare (10.000 Neurons/Tag frei, keine Speicherung, kein Training).
  "ai": { "binding": "AI" },
  "observability": {
    "enabled": true
  },
  "vars": {
    "GEMINI_MODEL": "gemini-3.6-flash",
    "GROQ_MODEL": "llama-3.3-70b-versatile",
    "GROQ_VISION_MODEL": "meta-llama/llama-4-scout-17b-16e-instruct",
    "WORKERS_AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "CEREBRAS_MODEL": "gpt-oss-120b",
    "MISTRAL_MODEL": "mistral-medium-latest"
  }
}
